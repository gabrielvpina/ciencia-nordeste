# Modelo do .env (segredos e configuração local). Copie para .env e preencha: cp .env.example .env
# O .env nunca entra no git. Guia completo: docs/rodar-localmente.md

# ---------------------------------------------------------------- banco (docker compose)
# Gere uma senha forte, por exemplo: openssl rand -base64 24
POSTGRES_DB=ciencia
POSTGRES_USER=ciencia
POSTGRES_PASSWORD=

# ---------------------------------------------------------------- ingestão (ingest/)
# Obrigatório: vai no User-Agent das requisições (boa prática com APIs públicas como OpenAlex e Crossref).
CONTACT_EMAIL=
# Obrigatório para as Partes 4, 5 e 8: chave gratuita do OpenAlex (https://openalex.org/settings/api).
OPENALEX_API_KEY=
# Ano inicial do recorte. Fixe 2022 para reproduzir a base publicada; sem valor, vira (ano atual − 4).
YEAR_START=2022
# Opcional: token da API do dados.gov.br (sem ele, o portal responde 401 e a Parte 0 registra a fonte como indisponível).
DADOS_GOV_BR_TOKEN=
# Opcional: tamanho da amostra OpenAlex × ORCID no diagnóstico de fontes (Parte 0).
AMOSTRA_ORCID=500

# ---------------------------------------------------------------- app (apps/web)
# Endereço público, usado no sitemap e nos links absolutos. Local: http://localhost:3000
SITE_URL=http://localhost:3000

# ---------------------------------------------------------------- backup (scripts/backup.sh)
# Pasta dos pacotes, retenção e, opcionalmente, uma segunda cópia (ex.: uma pasta sincronizada com a nuvem).
BACKUP_DIR=~/Backups/ciencia-nordeste
BACKUP_RETENCAO=14
BACKUP_COPIA_EXTRA=

# ---------------------------------------------------------------- só no servidor (docs/deploy/guia-deploy-ec2.qmd)
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml:docker-compose.https.yml
