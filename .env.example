
# Banco local (docker compose). Gere uma senha forte.
POSTGRES_DB=ciencia
POSTGRES_USER=ciencia
POSTGRES_PASSWORD=

# Backup (scripts/backup.sh). Pasta dos pacotes, retenção e, opcionalmente, uma segunda cópia
# (ex.: uma pasta sincronizada com a nuvem).
BACKUP_DIR=~/Backups/ciencia-nordeste
BACKUP_RETENCAO=14
BACKUP_COPIA_EXTRA=
